# Copy to .env for local development. In production (Render), set these
# as real environment variables in the dashboard instead — never commit
# a filled-in .env to GitHub.

FLASK_ENV=development
SECRET_KEY=16f46d1705182dbabdf0f6d7534a7aead84ed04aff3504a636a30b70b18085b0
# --- Database ---
# Leave DATABASE_URL unset locally to use the bundled SQLite database.
# In production, paste your Supabase connection string here (Supabase
# dashboard > Project Settings > Database > Connection string > URI,
# "Transaction" pooler mode, port 6543):
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- File storage ---
# Leave SUPABASE_URL / SUPABASE_KEY unset locally to store files on disk
# under storage/. Set both to switch to Supabase Storage (required in
# production — Render's free disk is not persistent).
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=vaultline-documents

# --- Default admin account ---
# Auto-created locally on first run. In production, run `flask seed-admin`
# once after your first deploy instead.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Set to true only once you're serving over HTTPS (Render does this for you).
SESSION_COOKIE_SECURE=false
